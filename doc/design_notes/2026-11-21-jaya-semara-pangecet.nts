;; "Jaya Semara" (I Wayan Beratha, 1964): one gong cycle of the pangecet.
;;
;; Written in the proposed notation described in
;; 2026-11-21-notation-language.md. The current reader cannot read it.
;;
;; Transcribed from Lisa Gold, Music in Bali (2005):
;;   gong pattern               activity 2.4, p. 43
;;   jublag, jegogan, panyacah  activities 3.1 and 3.2, pp. 56-58
;;   gangsa norot kotekan       figure 3.1, p. 61 (staff notation)
;;   ugal                       figure 3.1, where it plays the pokok
;;   instrument ranges          figure 2.7, p. 40
;;
;; Gold's cipher in this notation: 1 2 3 5 6 are i o e u a, and a cipher
;; dot (an empty beat on which the note keeps sounding) is _ .
;;
;; The pokok is a four-note descending melody, 8 pulses long, played
;; twice in each 16-pulse gong cycle. Gold reads it starting from the
;; gong stroke, so the piece opens with a one-pulse pickup on the gong,
;; where every part plays 2 (o).
;;
;; Not notated here: the reyong norot (described but not written out in
;; the book), the alternation with nyog-cag kotekan, dynamics and tempo.

(piece "Jaya Semara: pangecet" :colotomy pangecet-16 :pickup 1)

(use gong-kebyar)

;; ---------------------------------------------------------------
;; Definitions not yet in the template (they replace the template's).

;; Only the strokes this piece uses: gong, kempur and klentong.
(strokes gong-strokes
  G                ; gong
  P                ; kempur
  T)               ; klentong (kemong)
(instrument gong gong-strokes  G P T)

;; Ranges from Gold's figure 2.7. The ugal (o1 to i3) comes from the
;; template.
(instrument jegogan  selisir  i1 o1 e1 u1 a1)
(instrument jublag   selisir  i2 o2 e2 u2 a2)
(instrument panyacah selisir  i3 o3 e3 u3 a3)
(instrument pemade   selisir  o2 e2 u2 a2 i3 o3 e3 u3 a3 i4)

;; Gold calls this meter bapang (p. 140): kempur, klentong, kempur,
;; gong. Here it spans 16 pulses (activity 2.4): kempur on 4 and 12,
;; klentong on 8, gong on 16.
(colotomy pangecet-16 16
  (gong gong  -:3 P:1 -:3 T:1 -:3 P:1 -:3 G:1))

;; ---------------------------------------------------------------
;; Patterns. Each part below is built from these.

;; The pokok, 8 pulses, as Gold writes it for the jublag: . 1 . 6 . 3 . 2
;; It starts with a hold: the note before it keeps sounding.
(pattern pokok :short "pokok" :long "Pokok: 1 6 3 2"
  _ i2 _ a2 _ e2 _ o2)

;; The ugal's pokok, with the 6 (a) displaced an octave down.
(pattern pokok-ugal :short "pokok" :long "Pokok: 1 6 3 2, low 6"
  _ i2 _ a1 _ e2 _ o2)

;; The panyacah fills in the pokok: 6 1 5 6 2 3 1 2
(pattern panyacah-fill :short "fill" :long "Panyacah: 6 1 5 6 2 3 1 2"
  a3 i3 u3 a3 o3 e3 i3 o3)

;; The jegogan plays every other pokok tone: . . . 6 . . . 2
(pattern jegogan-pokok :short "jegogan" :long "Jegogan: 6 2"
  _ _ _ a1 _ _ _ o1)

;; Norot kotekan: a 2-pulse figure for each pokok tone, four notes per
;; pulse. In the first pulse both parts anticipate the tone; in the
;; second the polos stays on it and the sangsih plays the key above.
(pattern polos-1 :short "1" :long "Norot polos on 1"
  o3:1/4 i3 i3 - | i3 - i3 -)
(pattern polos-3 :short "3" :long "Norot polos on 3"
  a2:1/4 e3 e3 - | e3 - e3 -)
(pattern sangsih-1 :short "1" :long "Norot sangsih on 1"
  -:1/4 i3 i3 o3 | - o3 - o3)

;; One pass of the melody, 8 pulses. The figures on 6 and 2 are the
;; figure on 1 moved a degree down and up; the sangsih on 3 is its
;; figure on 1 moved two degrees up.
(pattern polos :short "norot" :long "Norot kotekan, polos"
  @polos-1  (@ polos-1 :step -1)  @polos-3  (@ polos-1 :step 1))
(pattern sangsih :short "norot" :long "Norot kotekan, sangsih"
  @sangsih-1  (@ sangsih-1 :step -1)  (@ sangsih-1 :step 2)  (@ sangsih-1 :step 1))

;; ---------------------------------------------------------------
;; The music. The kempli (16 strokes) and the gong part are generated
;; from the colotomy.
;;
;; Each part: a one-pulse pickup on the gong, ||, the 8-pulse melody
;; twice (one 16-pulse cycle), ||. In the pickup every part plays 2 (o),
;; the end of the melody.

(part pemade :name polos    o3:1/4 - o3 -  || (rep 2 @polos)         ||)
(part pemade :name sangsih  -:1/4 e3 - e3  || (rep 2 @sangsih)       ||)
(part ugal                  o2             || (rep 2 @pokok-ugal)    ||)
(part panyacah              o3             || (rep 2 @panyacah-fill) ||)
(part jublag                o2             || (rep 2 @pokok)         ||)
(part jegogan               o1             || (rep 2 @jegogan-pokok) ||)

(group "Gangsa pemade" :subtitle "norot" polos sangsih)
(group "Ugal"          ugal)
(group "Panyacah"      panyacah)
(group "Jublag"        jublag)
(group "Jegogan"       jegogan)
